---
import Base from './Base.astro';
import data from '../data/tools.json';
import InstallPdfApp from '../components/InstallPdfApp.astro';

const { slug } = Astro.props;

const tool = data.tools.find((t) => t.slug === slug);
if (!tool) throw new Error(`No entry in tools.json for slug "${slug}"`);

const category = data.categories.find((c) => c.slug === tool.category);

// Keyword first, brand last. The optional titleSuffix carries a short benefit
// phrase; without one we fall back to the bare title.
const metaTitle = tool.titleSuffix
  ? `${tool.title} — ${tool.titleSuffix} | gazza.ltd`
  : `${tool.title} | gazza.ltd`;
const related = (tool.related || [])
  .map((s) => data.tools.find((t) => t.slug === s))
  .filter((t) => t && t.published);

// FAQ schema is built from the faq slot's data passed via props
const faq = Astro.props.faq || [];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: tool.title,
  description: tool.metaDescription,
  applicationCategory: 'UtilitiesApplication',
  operatingSystem: 'Any',
  url: `https://gazza.ltd/${tool.slug}`,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'GBP' },
};

const faqSchema = faq.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<Base title={metaTitle} description={tool.metaDescription} category={tool.category}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> ›
      <a href={`/${category.slug}`}>{category.name}</a> ›
      <span>{tool.title}</span>
    </nav>

    {/* 1. H1 = the exact search term */}
    <h1>{tool.h1}</h1>

    {/* 2. The tool, immediately, above the fold */}
    <div class="tool-panel">
      <slot name="tool" />
    </div>

    {/* Offer installation on the PDF tools themselves, not just the hub —
        most visitors arrive here from search and never see /pdf. Only these
        tools work offline, so only these offer it. */}
    {tool.category === 'pdf' && <InstallPdfApp />}

    <div class="ad-slot">Ad</div>

    {/* 3–5. Explanation, method, worked example */}
    <div class="prose">
      <slot name="intro" />

      <h2>How it works</h2>
      <slot name="how-it-works" />

      <h2>Worked example</h2>
      <slot name="example" />
    </div>

    {/* 6. FAQ */}
    {faq.length > 0 && (
      <section class="prose">
        <h2>Common questions</h2>
        {faq.map((f) => (
          <div class="faq-item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </section>
    )}

    {/* 7. Related tools */}
    {related.length > 0 && (
      <section>
        <h2>Related tools</h2>
        <ul class="card-grid">
          {related.map((r) => (
            <li>
              <a class="card" href={`/${r.slug}`}>
                <span class="name">{r.title}</span>
                <span class="desc">{r.metaDescription.slice(0, 70)}…</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}

    {/* Point PDF users at the explainer. Someone on a PDF tool page has the
         file in front of them and is the most likely person to care whether it
         gets uploaded — and this is the query class we can actually win. */}
    {tool.category === 'pdf' && (
      <p class="embed-offer-inline">
        <strong>Your file is not uploaded.</strong> Everything happens on your
        own device — <a href="/pdf-without-uploading">here's how to check that
        for yourself</a>, and where upload-based tools are genuinely better.
      </p>
    )}

    {/* Offer the embed where the person who wants it already is: a broker or
         conveyancer reading the stamp duty page is exactly who would put this
         on their own site. Only shown for tools that are actually embeddable. */}
    {tool.embeddable && (
      <p class="embed-offer-inline">
        <strong>Want this calculator on your own website?</strong>{' '}
        <a href="/embed">Copy one line of HTML</a> — free, no sign-up, and it
        updates itself when tax rates change.
      </p>
    )}

    {/* Optional: data-source credits, where a licence requires attribution */}
    {Astro.slots.has('credits') && (
      <p class="credits"><slot name="credits" /></p>
    )}
  </div>

  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
</Base>

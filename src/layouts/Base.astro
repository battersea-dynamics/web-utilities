---
import '../styles/global.css';
import { visibleCategories, publishedTools } from '../data/site.js';

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  // Keeps a page out of search results. Used by internal tools like
  // /pwa-check, which exist for us rather than for visitors.
  noindex = false,
  // Sets <body data-cat="…">, which lets a category override design tokens
  // in global.css §2 without touching any component.
  category = null,
} = Astro.props;

const site = 'https://gazza.ltd';
const canonical = new URL(canonicalPath, site).href;
const categories = visibleCategories;
const published = publishedTools;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <!-- Installable PDF tools. The manifest is linked site-wide because a
         browser will only offer installation from a page that declares it,
         and people arrive at the PDF tools from search, not via /pdf. The
         manifest's start_url sends them to /pdf regardless. -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f6b5c" />
    <meta name="apple-mobile-web-app-title" content="gazza PDF" />

    <!-- Catch the install event as early as possible.
         Chrome fires `beforeinstallprompt` during page load, and the install
         panel's own script is a module — which browsers defer — so it can
         attach its listener AFTER the event has already fired and miss it
         entirely. The panel then never appears, even for someone who could
         install. This inline script runs immediately, stashes the event, and
         tells the panel it's ready. Must stay `is:inline` and stay in <head>;
         bundling it would reintroduce the delay it exists to avoid. -->
    <script is:inline>
      window.__installPrompt = null;
      window.addEventListener('beforeinstallprompt', function (e) {
        e.preventDefault();
        window.__installPrompt = e;
        window.dispatchEvent(new Event('installpromptready'));
      });
    </script>
  </head>

  <body data-cat={category}>
    <header class="site-head">
      <div class="wrap">
        <a class="brand" href="/">gazza<span>.ltd</span></a>
        <nav class="site-nav" aria-label="Categories">
          {categories.map((c) => <a href={`/${c.slug}`}>{c.name}</a>)}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-foot">
      <div class="wrap foot-cols">
        {categories.map((c) => (
          <div>
            <h3>{c.name}</h3>
            <ul>
              {published
                .filter((t) => t.category === c.slug)
                .map((t) => <li><a href={`/${t.slug}`}>{t.title}</a></li>)}
            </ul>
          </div>
        ))}
      </div>
      <div class="wrap foot-bottom">
        <p>Free online tools. No sign-up, nothing stored.</p>
        <nav aria-label="Site">
          <a href="/about">About</a> &nbsp;·&nbsp;
          <a href="/embed">Add a calculator to your site</a> &nbsp;·&nbsp;
          <a href="/privacy-policy">Privacy Policy</a> &nbsp;·&nbsp;
          <a href="mailto:hello@gazza.ltd">Spotted a problem?</a>
        </nav>
      </div>
    </footer>
  </body>
</html>

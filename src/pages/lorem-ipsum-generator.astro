---
import ToolPage from '../layouts/ToolPage.astro';
import LoremIpsumWidget from '../components/tools/LoremIpsumWidget.jsx';

const faq = [
  {
    q: 'What is Lorem Ipsum?',
    a: 'Placeholder text derived from a scrambled passage of Cicero\'s Latin, used since the 1500s in printing and, more recently, in design mockups, so that layout can be judged without real content distracting from it.',
  },
  {
    q: 'Why doesn’t it mean anything?',
    a: 'That’s the point — meaningless text keeps a reviewer focused on the layout, spacing and typography rather than reading the words.',
  },
  {
    q: 'Can I generate just a few words instead of paragraphs?',
    a: 'Yes, switch the "generate by" option to words or sentences and set how many you need.',
  },
  {
    q: 'Is the output different every time?',
    a: 'Yes, sentences are assembled from the classic Lorem Ipsum word bank in random order each time, so no two generations are identical.',
  },
  {
    q: 'Why not just use real sentences instead?',
    a: 'Real, readable text pulls a reviewer’s attention toward the words themselves — they start editing the copy instead of judging the layout. Lorem Ipsum’s Latin-like but meaningless structure keeps the focus on spacing, hierarchy and typography, which is the point at the mockup stage.',
  },
];
---
<ToolPage slug="lorem-ipsum-generator" faq={faq}>
  <LoremIpsumWidget client:load slot="tool" />

  <p slot="intro">
    Generate placeholder Lorem Ipsum text by paragraph, sentence or word
    count, ready to drop into a design mockup, a CMS while testing layout,
    or anywhere else you need filler text that isn't distractingly readable.
  </p>

  <div slot="how-it-works">
    <p>
      Sentences are built by picking words at random from the traditional
      Lorem Ipsum word list and joining them with sentence-length
      punctuation. Paragraphs are built from several such sentences. You can
      optionally force the output to start with the classic
      "Lorem ipsum dolor sit amet…" opening line.
    </p>
  </div>

  <div slot="example">
    <p>
      Ask for 3 paragraphs and you'll get three blocks of randomly generated
      Latin-style filler text, each several sentences long, separated by
      blank lines — ready to paste straight into a design tool.
    </p>
    <p>
      Word count matters for layout testing too: a card component that
      looks fine with a 6-word placeholder title might break with a
      realistic 15-word one, so it's worth generating a few different
      lengths rather than testing with just one.
    </p>
  </div>
</ToolPage>

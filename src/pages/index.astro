---
import Base from '../layouts/Base.astro';
import { visibleCategories, publishedTools } from '../data/site.js';

const categories = visibleCategories;
const tools = publishedTools;
const liveCount = tools.length;
---
<Base
  title="Free Online Calculators & Tools | gazza.ltd"
  description="Free online calculators and tools for mortgages, PDFs, text and word games. Every one runs in your browser, shows its working, and needs no sign-up."
>
  <div class="wrap">
    <div class="page-head">
      <h1>Calculators that show their working</h1>
      <p class="standfirst">
        Free, fast tools for the questions a search box can't answer in one line —
        mortgages, take-home pay, dates, conversions and more. Every tool explains
        the method underneath, so you can check the number rather than trust it.
      </p>
    </div>

    <ul class="category-grid">
      {categories.map((c) => {
        const liveInCat = tools.filter((t) => t.category === c.slug).length;
        return (
          <li>
            <a class="category-card" href={`/${c.slug}`}>
              <span class="cat-name">{c.name}</span>
              <span class="cat-blurb">{c.blurb}</span>
              <span class="cat-count">
                {liveInCat} tool{liveInCat === 1 ? '' : 's'}
              </span>
            </a>
          </li>
        );
      })}
    </ul>

    <section class="cat-block">
      <h2>About these tools</h2>
      <div class="prose">
        <p>
          There are {liveCount} tools live so far, with more added regularly.
          Everything runs in your browser — nothing you type is sent anywhere or
          stored, and there is no sign-up.
        </p>
        <p>
          Each tool page shows the formula it uses and a worked example with real
          numbers, because a figure you can't check isn't much use.
        </p>
      </div>
    </section>
  </div>
</Base>

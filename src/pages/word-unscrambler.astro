---
import ToolPage from '../layouts/ToolPage.astro';
import UnscrambleWidget from '../components/tools/UnscrambleWidget.jsx';

const faq = [
  {
    q: 'Can I see what a word means?',
    a: 'Yes — click any word in the results and its definition appears underneath. Definitions are only fetched when you ask for one, so they never slow the search down. About one word in twelve has no definition available; those are still valid words, we just don\u2019t hold a meaning for them.',
  },
  {
    q: 'How many letters can I enter?',
    a: 'Up to 15. That covers every standard word-game rack with plenty of room to spare.',
  },
  {
    q: 'Do I have to use every letter?',
    a: 'No — this tool finds every valid word using any subset of the letters you type, from two-letter words up to using them all.',
  },
  {
    q: 'Can I use a blank or wildcard tile?',
    a: 'Not yet. For now, enter only the letters you actually have; wildcard support may be added later.',
  },
  {
    q: 'Why is a word I know missing from the results?',
    a: 'The dictionary behind this tool is a large general English word list, not the specific Scrabble or Words With Friends tournament dictionaries, so a small number of valid game words won’t appear yet.',
  },
  {
    q: 'Does this work for any word game?',
    a: 'It works for finding valid English words in general — Scrabble, Words With Friends, Wordscapes and similar games. Game-specific letter scoring is coming in dedicated Scrabble and Words With Friends tools.',
  },
  {
    q: 'Can I unscramble letters in another language?',
    a: 'A language switcher is built into the tool. Only English has a dictionary behind it right now — other languages are listed and will switch on as their word lists are added.',
  },
  {
    q: 'What’s the difference between this and an anagram solver?',
    a: 'An unscrambler treats every subset word as equally useful — two-letter words alongside the full jumble. An anagram solver specifically separates out the words that use every letter you entered. Both tools use the same dictionary; use whichever framing matches what you need.',
  },
];
---
<ToolPage slug="word-unscrambler" faq={faq}>
  <UnscrambleWidget client:load mode="unscramble" slot="tool" />

  <p slot="intro">
    Type the letters you have and this tool finds every word hiding inside
    them — not just the full jumble, but every shorter word too, grouped by
    length. Useful for word games, crosswords, or just settling an argument
    about whether a word is real.
  </p>

  <div slot="how-it-works">
    <p>
      Your letters are checked against a dictionary of English words. Rather
      than only looking for a single arrangement, the tool considers every
      possible subset of your letters — so seven letters can turn up two,
      three, four, five, six and seven-letter words all at once.
    </p>
    <p>
      Results are grouped by word length, longest first, so the strongest
      plays are easy to spot.
    </p>
    <p>
      The word list behind this tool is a curated, everyday English
      dictionary rather than a full competitive Scrabble word list — it's
      built to return words you'd actually recognise, not obscure dialect
      or archaic entries that happen to be technically valid in tournament
      play.
    </p>
  </div>

  <div slot="example">
    <p>
      Enter <code>tresalp</code> and you'll get seven-letter words like
      <em>plaster</em>, six-letter words like <em>petals</em>, plus dozens of
      shorter ones such as <em>rest</em>, <em>pale</em>, <em>slap</em> and
      <em>art</em>.
    </p>
  </div>

  <Fragment slot="credits">
    Word definitions are from <a href="https://wordnet.princeton.edu/" rel="nofollow noopener" target="_blank">WordNet 3.1</a>,
    Princeton University. WordNet is used here under its own licence, which permits
    free use provided this notice is retained.
  </Fragment>

</ToolPage>

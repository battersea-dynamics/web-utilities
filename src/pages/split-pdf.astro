---
import ToolPage from '../layouts/ToolPage.astro';
import PdfPagesWidget from '../components/tools/PdfPagesWidget.jsx';

const faq = [
  {
    q: 'How do I write the page ranges?',
    a: 'Use commas to separate entries and hyphens for ranges — for example "1-3, 8, 12-15". You can also write "10-" to mean from page 10 to the end of the document.',
  },
  {
    q: 'Does the order I type the pages matter?',
    a: 'Yes. Pages come out in the order you list them, so "5, 1, 3" produces a three-page PDF in exactly that sequence. That makes this tool double as a way to reorder while extracting.',
  },
  {
    q: 'What happens to the original file?',
    a: 'Nothing at all. The original on your computer is untouched — the tool produces a new file and leaves the source exactly as it was.',
  },
  {
    q: 'Can I split one PDF into many separate files at once?',
    a: 'Not in a single click. Run the tool once per output file, changing the range each time. For a small number of splits that’s quick; for dozens, a desktop PDF application will be faster.',
  },
  {
    q: 'Are my files uploaded?',
    a: 'No. Everything happens in your browser on your own device, and nothing is sent to a server.',
  },
  {
    q: 'Why did I get an error opening my PDF?',
    a: 'The most common cause is a password-protected file. PDFs that require a password to open can’t be read, so remove the protection in your PDF reader first.',
  },
];
---
<ToolPage slug="split-pdf" faq={faq}>
  <PdfPagesWidget client:load mode="extract" slot="tool" />

  <p slot="intro">
    Pull specific pages out of a PDF into a new, smaller file. Pick single
    pages, ranges, or any mixture of the two. The whole thing runs in your
    browser, so the document never leaves your device.
  </p>

  <div slot="how-it-works">
    <p>
      Your PDF is read on your own device and its page count is shown. When you
      enter a range, the tool builds a brand-new empty document and copies only
      the pages you asked for into it, in the order you typed them.
    </p>
    <p>
      Page numbers are one-based, matching what your PDF reader shows: page 1 is
      the first page. Anything outside the document's range is ignored rather
      than causing an error, so a stray "50" on a 20-page file does no harm.
    </p>
    <p>
      Because pages are copied rather than redrawn, text stays selectable and
      images keep their original quality.
    </p>
  </div>

  <div slot="example">
    <p>
      You've been sent a 60-page tenancy agreement and only need the schedule at
      the back plus the signature page. Entering <code>45-52, 60</code> gives you
      a nine-page PDF containing exactly those, small enough to email and quick
      for the other party to read.
    </p>
    <p>
      A second common case is a bank statement: entering <code>2-</code> strips
      the cover page and keeps everything from page two onwards.
    </p>
  </div>
</ToolPage>
